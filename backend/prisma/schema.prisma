generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketType {
  Жалоба
  Смена_данных
  Консультация
  Претензия
  Неработоспособность_приложения
  Мошеннические_действия
  Спам
}

enum Sentiment {
  Позитивный
  Нейтральный
  Негативный
}

enum Segment {
  VIP
  MASS
  PRIORITY
}

enum Language {
  KZ
  ENG
  RU
}

enum ManagerPosition {
  Специалист
  Ведущий_специалист
  Главный_специалист
}

enum ManagerSkill {
  VIP
  ENG
  KZ
}

model Office {
  id        String    @id @default(cuid())
  name      String
  address   String
  latitude  Float?
  longitude Float?
  managers  Manager[]
  tickets   Ticket[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Manager {
  id                 String               @id @default(cuid())
  fullName           String
  position           ManagerPosition
  officeId           String
  office             Office               @relation(fields: [officeId], references: [id])
  skills             ManagerSkill[]
  activeTicketCount  Int                  @default(0)
  tickets            Ticket[]
  assignmentLogsFrom AssignmentLog[]      @relation("FromManager")
  assignmentLogsTo   AssignmentLog[]      @relation("ToManager")
  assignmentLogsBy   AssignmentLog[]      @relation("AssignedBy")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Ticket {
  id               String           @id @default(cuid())
  clientGuid       String
  gender           String
  dateOfBirth      DateTime
  description      String           @db.Text
  attachments      String?
  segment          Segment
  country          String
  oblast           String
  city             String
  street           String
  houseNumber      String
  managerId        String?
  manager          Manager?         @relation(fields: [managerId], references: [id])
  officeId         String?
  office           Office?          @relation(fields: [officeId], references: [id])
  importSessionId  String?
  importSession    ImportSession?   @relation(fields: [importSessionId], references: [id])
  analysis         TicketAnalysis?
  assignmentLogs   AssignmentLog[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([segment])
  @@index([managerId])
  @@index([officeId])
  @@index([importSessionId])
}

model ImportSession {
  id            String   @id @default(cuid())
  name          String?
  totalTickets  Int      @default(0)
  status        String   @default("COMPLETED") // COMPLETED, FAILED, PROCESSING
  tickets       Ticket[]
  createdAt     DateTime @default(now())
}

model TicketAnalysis {
  id        String     @id @default(cuid())
  ticketId  String     @unique
  ticket    Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type      TicketType
  sentiment Sentiment
  priority  Int        @default(1)
  language  Language   @default(RU)
  summary   String     @db.Text
  latitude  Float?
  longitude Float?
  aiDuration      Int?       @default(0)
  geoDuration     Int?       @default(0)
  routingDuration Int?       @default(0)
  totalDuration   Int?       @default(0)
  trace           Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model AssignmentLog {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromManagerId String?
  fromManager   Manager? @relation("FromManager", fields: [fromManagerId], references: [id])
  toManagerId   String
  toManager     Manager  @relation("ToManager", fields: [toManagerId], references: [id])
  assignedById  String
  assignedBy    Manager  @relation("AssignedBy", fields: [assignedById], references: [id])
  reason        String?
  createdAt     DateTime @default(now())
}
